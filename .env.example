NEXT_PUBLIC_SUPABASE_URL=your_supabase_project_url
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_supabase_anon_key
SUPABASE_SERVICE_ROLE_KEY=your_supabase_service_role_key
ADMIN_USER=your_admin_username
ADMIN_PASSWORD=your_admin_password
# Required in production: random string (32+ chars). Signs the ADMIN session cookie only.
# (Legacy alias of APP_SIGNING_SECRET. Player links no longer use it: since Stage 1.3 every
# player capability is a server-side row in registration_sessions.)
ADMIN_SESSION_SECRET=

# DocuSeal webhook HMAC secret (Console → Webhooks → Security → HMAC tab, whsec_...)
DOCUSEAL_WEBHOOK_SECRET=
DOCUSEAL_API_KEY=your_docuseal_api_key
DOCUSEAL_ADULT_TEMPLATE_ID=your_adult_template_id
DOCUSEAL_YOUTH_TEMPLATE_ID=your_youth_template_id

# Stripe — plug in your keys from https://dashboard.stripe.com/apikeys
STRIPE_SECRET_KEY=sk_live_...
NEXT_PUBLIC_STRIPE_PUBLISHABLE_KEY=pk_live_...
# Webhook secret from https://dashboard.stripe.com/webhooks (point to /api/stripe/webhook)
STRIPE_WEBHOOK_SECRET=whsec_...

# Site URL for Stripe checkout success/cancel redirects and resume-link emails
NEXT_PUBLIC_SITE_URL=https://yourdomain.com

# Resend — delivers the one-time registration resume links (src/lib/email/resend-sender.ts).
# Key must have "Sending access" for the From domain, which must be verified in Resend.
RESEND_API_KEY=
RESUME_EMAIL_FROM="Houston Premier Soccer <noreply@yourdomain.com>"
RESUME_EMAIL_REPLY_TO=
